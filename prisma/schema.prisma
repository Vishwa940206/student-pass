// Student Pass — MVP schema: verified pass, offers, merchant POS redemption.
// Money is stored as integer LKR cents (Int) to avoid floating point errors.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Identity ─────────────────────────

enum Role {
  STUDENT
  MERCHANT_STAFF
  INSTITUTION_STAFF
  ADMIN // platform admin (Student Pass team)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  student       StudentProfile?
  staff         MerchantStaff?
  savedOffers   SavedOffer[]
  authorizedPos Authorization[] @relation("AuthorizedBy")

  institutionStaff InstitutionStaff?
  announcements    Announcement[]
  eventsCreated    Event[]
  coursesTaught    Course[]
  gradesGiven      Grade[]
  leadsOwned       Lead[]          @relation("Counsellor")
  leadActivities   LeadActivity[]
  sessionsTaken    AttendanceSession[]
  invoicesCreated  Invoice[]
  paymentsRecorded Payment[]
  listings         Listing[]
}

model Session {
  id        String   @id // sha256 of the cookie token; the raw token is never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ───────────────────────── Students & institutions ─────────────────────────

enum InstitutionType {
  UGC_UNIVERSITY
  PUBLIC_UNIVERSITY
  DEGREE_AWARDING
  FOREIGN_DEGREE_PROVIDER
}

model Institution {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  shortName String
  district  String
  type      InstitutionType
  isPartner Boolean         @default(false)

  // White-label branding (Institution OS → Settings). Null = Student Pass defaults.
  displayName   String? // e.g. "Inspire College Campus"
  brandColor    String? // "#RRGGBB"
  tagline       String?
  logo          Bytes? // PNG/JPEG/WebP/SVG, ≤ 256 KB, served at /api/v1/institutions/:id/logo
  logoType      String?
  logoUpdatedAt DateTime?

  // Licensed Institution OS modules (B2B entitlements), switched by the platform admin.
  modules String[] @default(["crm", "admissions", "analytics", "market", "lms", "fees", "ai", "payments"])

  // Online payments (PayHere). The secret is AES-256-GCM encrypted (src/lib/crypto.ts).
  payhereMerchantId String?
  payhereSecretEnc  String?
  payhereSandbox    Boolean @default(true)

  students       StudentProfile[]
  sponsoredOffers Offer[]

  staff         InstitutionStaff[]
  announcements Announcement[]
  events        Event[]
  clubs         Club[]
  courses       Course[]
  programmes    Programme[]
  leads         Lead[]
  applications  Application[]
  invoices      Invoice[]
  knowledge     KnowledgeEntry[]
  conversations Conversation[]
  proposals     ProposalRequest[]
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum PassState {
  ACTIVE
  FROZEN // frozen by the student (lost phone / card); cannot be scanned
}

model StudentProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId      String
  institution        Institution        @relation(fields: [institutionId], references: [id])
  studentNumber      String
  programme          String?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  validUntil         DateTime?
  // Opaque id that appears inside the QR token. Never the user id, name or institution.
  passId             String             @unique @default(cuid())
  passState          PassState          @default(ACTIVE)
  cardSkin           String             @default("graphite")
  createdAt          DateTime           @default(now())

  authorizations Authorization[]
  redemptions    Redemption[]

  rsvps      EventRsvp[]
  clubs      ClubMember[]
  enrolments Enrolment[]
  grades     Grade[]
  progress    LessonProgress[]
  attendance  Attendance[]
  submissions Submission[]
  invoices    Invoice[]
  chats       Conversation[]
  points       PointsEntry[]
  rewardsTaken RewardRedemption[]
  reservations Reservation[]
  responses    ListingResponse[]

  @@unique([institutionId, studentNumber])
}

// ───────────────────────── Merchants ─────────────────────────

model Merchant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  locations MerchantLocation[]
  staff     MerchantStaff[]
  offers    Offer[]
  products  Product[]
}

model MerchantLocation {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  code        String // e.g. "KOL" — short code printed on receipts
  name        String
  district    String
  inProgramme Boolean  @default(true)

  authorizations Authorization[]
  offerLinks     OfferLocation[]

  @@unique([merchantId, code])
}

model MerchantStaff {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Offers ─────────────────────────

enum Channel {
  IN_STORE
  ONLINE
}

enum OfferStatus {
  DRAFT
  PROSPECT // listed for browsing; partner terms not yet confirmed — cannot be redeemed
  LIVE
  PAUSED
  ENDED
}

enum DiscountType {
  PERCENT // discountValue = basis points (1000 = 10%)
  FIXED // discountValue = cents off
  SPONSORED // institution pays up to discountValue cents per redemption
}

model Offer {
  id          String       @id @default(cuid())
  slug        String       @unique
  merchantId  String?
  merchant    Merchant?    @relation(fields: [merchantId], references: [id])
  title       String
  benefit     String
  howTo       String
  category    String
  badge       String // short display word from the prototype ("Brew", "AI", …)
  channel     Channel
  districts   String[] // empty = available everywhere / online
  status      OfferStatus  @default(DRAFT)
  externalUrl String? // provider-managed plans (redeemed on the provider's site)

  discountType     DiscountType?
  discountValue    Int?
  maxDiscountCents Int?
  minSpendCents    Int?

  // Optional sponsored-offer rules
  sponsorId          String?
  sponsor            Institution? @relation(fields: [sponsorId], references: [id])
  sponsorBudgetCents Int? // remaining budget; decremented on capture
  limitPerWeek       Int?
  limitPerYear       Int?

  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  locations      OfferLocation[] // empty = every location of the merchant
  savedBy        SavedOffer[]
  authorizations Authorization[]
  redemptions    Redemption[]

  @@index([status, category])
}

model OfferLocation {
  offerId    String
  offer      Offer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  locationId String
  location   MerchantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([offerId, locationId])
}

model SavedOffer {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, offerId])
}

// ───────────────────────── POS: authorise → capture ─────────────────────────

enum AuthorizationStatus {
  HELD // discount reserved, waiting for the sale to complete
  CAPTURED // sale completed → a Redemption exists
  CANCELLED // basket changed / sale abandoned
  EXPIRED
}

model Authorization {
  id             String              @id @default(cuid())
  idempotencyKey String              @unique // supplied by the POS; retries return the same row
  studentId      String
  student        StudentProfile      @relation(fields: [studentId], references: [id])
  offerId        String
  offer          Offer               @relation(fields: [offerId], references: [id])
  locationId     String
  location       MerchantLocation    @relation(fields: [locationId], references: [id])
  authorizedById String
  authorizedBy   User                @relation("AuthorizedBy", fields: [authorizedById], references: [id])
  // The 30-second token window that was scanned. One scan → one authorisation (replay guard).
  tokenStep      Int
  subtotalCents  Int
  discountCents  Int
  status         AuthorizationStatus @default(HELD)
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  redemption Redemption?

  @@unique([studentId, tokenStep])
  @@index([studentId, offerId, status])
}

model Redemption {
  id              String         @id @default(cuid())
  ref             String         @unique // human receipt ref, e.g. RCP-1041
  authorizationId String         @unique
  authorization   Authorization  @relation(fields: [authorizationId], references: [id])
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id])
  offerId         String
  offer           Offer          @relation(fields: [offerId], references: [id])
  discountCents   Int
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime       @default(now())

  @@index([studentId, offerId, createdAt])
}

// ───────────────────────── Institutions: staff accounts ─────────────────────────
// Every Campus Life / Institution OS row belongs to one institution, and every query
// is scoped by the signed-in person's institutionId (see src/lib/campus/access.ts).

enum StaffRole {
  ADMIN // everything: staff, verification, settings, CRM, admissions, campus, courses
  LECTURER // announcements, events, clubs, courses, assignments, grades
  COUNSELLOR // CRM, admissions, analytics, market intelligence
}

model InstitutionStaff {
  userId        String      @id
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  staffRole     StaffRole   @default(LECTURER)
  createdAt     DateTime    @default(now())

  @@index([institutionId])
}

// ───────────────────────── Campus Life ─────────────────────────

model Announcement {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  title         String
  body          String
  pinned        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([institutionId, createdAt])
}

model Event {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  title         String
  description   String
  location      String
  startsAt      DateTime
  endsAt        DateTime?
  capacity      Int? // null = unlimited
  createdAt     DateTime    @default(now())

  rsvps EventRsvp[]

  @@index([institutionId, startsAt])
}

model EventRsvp {
  eventId   String
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([eventId, studentId])
}

model Club {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  description   String
  createdAt     DateTime    @default(now())

  members ClubMember[]

  @@unique([institutionId, name])
}

model ClubMember {
  clubId    String
  club      Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime       @default(now())

  @@id([clubId, studentId])
}

// ───────────────────────── Courses ─────────────────────────

model Course {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  code          String // e.g. "CS101"
  name          String
  lecturerId    String?
  lecturer      User?       @relation(fields: [lecturerId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  enrolments  Enrolment[]
  assignments Assignment[]
  modules     CourseModule[]
  sessions    AttendanceSession[]

  @@unique([institutionId, code])
}

model Enrolment {
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolledAt DateTime       @default(now())

  @@id([courseId, studentId])
  @@index([studentId])
}

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  dueAt       DateTime
  maxMarks    Int      @default(100)
  createdAt   DateTime @default(now())

  grades      Grade[]
  submissions Submission[]

  @@index([courseId, dueAt])
}

model Grade {
  assignmentId String
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks        Int
  feedback     String?
  gradedById   String
  gradedBy     User           @relation(fields: [gradedById], references: [id])
  gradedAt     DateTime       @default(now()) @updatedAt

  @@id([assignmentId, studentId])
}

// ───────────────────────── Institution OS: admissions & CRM ─────────────────────────

enum StudyMode {
  FULL_TIME
  PART_TIME
  ONLINE
}

model Programme {
  id             String      @id @default(cuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name           String
  mode           StudyMode   @default(FULL_TIME)
  durationMonths Int?
  feeCents       Int? // per year, LKR cents
  intakes        String[] // e.g. ["Jan 2027", "May 2027"]
  open           Boolean     @default(true) // accepting enquiries / applications
  createdAt      DateTime    @default(now())

  leads        Lead[]
  applications Application[]

  @@unique([institutionId, name])
}

enum LeadSource {
  WEBSITE // the institution's public enquiry page
  STUDENT_PASS
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  WALK_IN
  PHONE
  REFERRAL
  EVENT
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  COUNSELLING
  APPLIED
  OFFER
  ENROLLED
}

model Lead {
  id             String      @id @default(cuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  district       String?
  source         LeadSource
  programmeId    String?
  programme      Programme?  @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  stage          LeadStage   @default(NEW)
  counsellorId   String?
  counsellor     User?       @relation("Counsellor", fields: [counsellorId], references: [id], onDelete: SetNull)
  consent        Boolean     @default(false) // agreed to be contacted
  lostAt         DateTime?
  lostReason     String?
  lastActivityAt DateTime    @default(now())
  createdAt      DateTime    @default(now())

  activities    LeadActivity[]
  application   Application?
  conversations Conversation[]

  @@index([institutionId, stage])
  @@index([institutionId, createdAt])
  @@index([counsellorId])
}

enum ActivityKind {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  STAGE // automatic: stage changed
  SYSTEM // automatic: created, assigned, marked lost…
}

model LeadActivity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind      ActivityKind
  body      String
  createdAt DateTime     @default(now())

  @@index([leadId, createdAt])
}

enum ApplicationStatus {
  UNDER_REVIEW
  OFFER_ISSUED
  ACCEPTED
  DEPOSIT_PAID
  ENROLLED
  REJECTED
  WITHDRAWN
}

model Application {
  id            String            @id @default(cuid())
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  leadId        String            @unique
  lead          Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  programmeId   String
  programme     Programme         @relation(fields: [programmeId], references: [id])
  intake        String
  status        ApplicationStatus @default(UNDER_REVIEW)
  statusAt      DateTime          @default(now()) // when the status last changed
  createdAt     DateTime          @default(now())

  @@index([institutionId, status])
}

// ───────────────────────── Rate limiting ─────────────────────────
// Fixed-window counters shared by every serverless instance (in-memory limits don't
// work on Vercel). Keys look like "login:ip:1.2.3.4" or "enquiry:inst:<id>".
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

// ───────────────────────── LMS: content, progress, attendance, submissions ─────────────────────────

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  lessons Lesson[]

  @@index([courseId, position])
}

model Lesson {
  id        String       @id @default(cuid())
  moduleId  String
  module    CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  body      String       @default("")
  url       String? // video, slides or reading link
  position  Int          @default(0)
  published Boolean      @default(true)
  createdAt DateTime     @default(now())

  progress LessonProgress[]

  @@index([moduleId, position])
}

model LessonProgress {
  lessonId    String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  completedAt DateTime       @default(now())

  @@id([lessonId, studentId])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

model AttendanceSession {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date        DateTime
  title       String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  records Attendance[]

  @@index([courseId, date])
}

model Attendance {
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus

  @@id([sessionId, studentId])
}

model Submission {
  assignmentId String
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  text         String         @default("")
  link         String?
  submittedAt  DateTime       @default(now()) @updatedAt

  @@id([assignmentId, studentId])
}

// ───────────────────────── Fees & payments ─────────────────────────

enum InvoiceStatus {
  DUE // overdue = DUE and dueDate has passed (derived, not stored)
  PAID
  VOID
}

model Invoice {
  id            String         @id @default(cuid())
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  number        String // INV-00001, per institution
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  item          String
  amountCents   Int
  dueDate       DateTime
  status        InvoiceStatus  @default(DUE)
  paidAt        DateTime?
  createdById   String
  createdBy     User           @relation(fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  // Family pay link (/pay/<token>): set when the student shares the invoice; null = not shared.
  payToken      String?        @unique

  payments Payment[]

  @@unique([institutionId, number])
  @@index([institutionId, status])
  @@index([studentId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD_ONLINE // through the payment gateway
  OTHER
}

enum PaymentStatus {
  PENDING // checkout started, waiting for the gateway's signed notification
  SUCCEEDED
  FAILED
  CANCELLED
}

model Payment {
  id               String        @id @default(cuid())
  invoiceId        String
  invoice          Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents      Int
  method           PaymentMethod
  status           PaymentStatus
  reference        String? // receipt no. / bank ref (manual) or gateway payment id
  gatewayOrderId   String?       @unique // the order_id we send to the gateway
  gatewayStatus    String? // last raw status_code from the gateway
  payerName        String? // set when someone else paid through a family pay link
  recordedById     String? // staff who recorded a manual payment
  recordedBy       User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([invoiceId])
}

// ───────────────────────── Conversational AI ─────────────────────────

model KnowledgeEntry {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  body          String
  source        String? // e.g. "Fee schedule 2026/27"
  approved      Boolean     @default(true) // only approved entries are used by the assistant
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId, approved])
}

enum ChatChannel {
  PUBLIC // enquiry page, not signed in
  STUDENT // Campus Life, signed-in verified student
}

model Conversation {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  channel       ChatChannel
  studentId     String?
  student       StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  leadId        String? // set when the conversation was handed to a counsellor
  lead          Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  handedOver    Boolean         @default(false)
  answered      Int             @default(0) // replies grounded in approved knowledge
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  messages ChatMessage[]

  @@index([institutionId, createdAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  sources        String[] // KnowledgeEntry ids the answer used
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ───────────────────────── B2B services ─────────────────────────

enum ProposalStatus {
  NEW
  CONTACTED
  WON
  LOST
}

model ProposalRequest {
  id              String         @id @default(cuid())
  institutionId   String? // set when requested from inside the portal
  institution     Institution?   @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  institutionName String
  contactName     String
  email           String
  studentsBand    String?
  items           String[] // service ids from src/lib/os/services.ts
  notes           String?
  status          ProposalStatus @default(NEW)
  createdAt       DateTime       @default(now())
}

// ───────────────────────── Pass Points ─────────────────────────
// A ledger: the balance is the sum of deltas. (reason, refId) is unique, so the same event
// can never be credited twice (e.g. a retried POS capture).

enum PointsReason {
  WELCOME // verified for the first time
  OFFER_REDEEMED // POS capture
  OFFER_VOIDED // POS refund reverses the credit
  FEE_PAID // an invoice was paid
  SHOP_COLLECTED // a shop reservation was collected
  REWARD // spent on a reward
  REWARD_REFUND // reward cancelled
  ADJUSTMENT // platform admin correction
}

model PointsEntry {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  delta     Int
  reason    PointsReason
  refId     String // id of the redemption / invoice / reservation / reward redemption
  note      String
  createdAt DateTime       @default(now())

  @@unique([reason, refId])
  @@index([studentId, createdAt])
}

model Reward {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  cost        Int // points
  stock       Int? // null = unlimited
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  redemptions RewardRedemption[]
}

enum RewardStatus {
  ISSUED
  USED
  CANCELLED
}

model RewardRedemption {
  id        String         @id @default(cuid())
  rewardId  String
  reward    Reward         @relation(fields: [rewardId], references: [id])
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  code      String         @unique // shown to the student, checked when used
  cost      Int
  status    RewardStatus   @default(ISSUED)
  createdAt DateTime       @default(now())

  @@index([studentId])
}

// ───────────────────────── Student Shop (reserve, pay & collect at the merchant) ─────────────────────────

model Product {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  title       String
  category    String
  subtitle    String   @default("")
  description String   @default("")
  art         String   @default("") // short display word on the card, like the design ("14\"", "CS")
  priceCents  Int // student price
  rrpCents    Int? // usual price
  stock       Int? // null = unlimited
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations Reservation[]

  @@index([active, category])
}

enum ReservationStatus {
  RESERVED // stock held until expiresAt
  COLLECTED // paid and collected at the merchant
  CANCELLED
  EXPIRED
}

model Reservation {
  id          String            @id @default(cuid())
  code        String            @unique // collection code shown to the student
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  studentId   String
  student     StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quantity    Int
  priceCents  Int // unit student price at the time of reserving
  status      ReservationStatus @default(RESERVED)
  expiresAt   DateTime
  collectedAt DateTime?
  createdAt   DateTime          @default(now())

  @@index([studentId, status])
  @@index([productId, status])
}

// ───────────────────────── Jobs & housing ─────────────────────────

enum ListingKind {
  JOB
  HOUSING
}

model Listing {
  id            String       @id @default(cuid())
  kind          ListingKind
  title         String
  organisation  String // employer or landlord shown to students
  description   String
  district      String
  pay           String // "LKR 1,200 / hour", "LKR 35,000 / month"
  postedById    String
  postedBy      User         @relation(fields: [postedById], references: [id])
  institutionId String? // set = only that institution's students see it
  open          Boolean      @default(true)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  responses ListingResponse[]

  @@index([kind, open, createdAt])
}

model ListingResponse {
  listingId String
  listing   Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  message   String
  phone     String?
  createdAt DateTime       @default(now())

  @@id([listingId, studentId])
}
