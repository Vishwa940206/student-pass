# ── Database ────────────────────────────────────────────────────────────────
# Option A: local development (pnpm db:up)
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/student_pass"

# Option B: Supabase (Project → Connect → ORMs / connection strings).
# Download the CA certificate (Project Settings → Database → SSL Configuration)
# and save it as prisma/certs/supabase-ca.crt.
#
# App runtime — transaction pooler, port 6543:
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=prisma/certs/supabase-ca.crt"
# Migrations (Prisma CLI) — session pooler, port 5432:
# DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=prisma/certs/supabase-ca.crt"

# ── Secrets ─────────────────────────────────────────────────────────────────
# Signs the rotating pass QR tokens. Generate with: openssl rand -base64 48
PASS_TOKEN_SECRET=""
